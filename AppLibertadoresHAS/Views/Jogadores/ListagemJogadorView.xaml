<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppLibertadoresHAS.Views.Jogadores.ListagemJogadorView"
             Title="Listagem de Jogadores">
    <ScrollView>
        <VerticalStackLayout Padding="10,0,0,0">
            <CollectionView x:Name="listView" ItemsSource="{Binding Jogadores}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Padding="10" BackgroundColor="LightGray">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" FontSize="18" FontAttributes="Bold" Text="{Binding Nome}" />
                                    <Label Grid.Column="1" FontSize="18" FontAttributes="Bold" Text="{Binding Numero, StringFormat='#{0}'}" />
                                </Grid>
                                <Label FontSize="14" HorizontalOptions="Center" Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" />
                                <BoxView HeightRequest="1" BackgroundColor="DarkGray" />
                                <Label FontSize="14" Text="{Binding Time, StringFormat='Time: {0}'}" />
                                <Label FontSize="12" Text="{Binding Posicao, StringFormat='Posição: {0}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>